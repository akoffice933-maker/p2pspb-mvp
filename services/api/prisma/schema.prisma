generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Статусы заказа (state machine)
enum OrderStatus {
  PENDING      // Ожидает подтверждения
  ACTIVE       // Активная заявка
  RESERVED     // Средства зарезервированы
  PAYMENT_PENDING  // Ожидает оплаты
  PAID         // Оплата получена
  CONFIRMED    // Подтверждено покупателем
  COMPLETED    // Завершено успешно
  CANCELLED    // Отменено
  DISPUTED     // Спор
  RESOLVED     // Спор решён
  HIDDEN       // Скрыто админом
}

// Типы транзакций
enum TransactionType {
  RESERVE      // Резервирование средств
  PAYMENT      // Оплата
  RELEASE      // Выпуск средств продавцу
  REFUND       // Возврат покупателю
  ESCROW       // Перевод на эскроу
}

// Типы фрод-алертов
enum AlertType {
  VELOCITY           // Слишком частые операции
  AMOUNT             // Подозрительная сумма
  MULTI_ACCOUNT      // Несколько аккаунтов
  BEHAVIOR           // Аномальное поведение
  DEVICE             // Подозрительное устройство
  IP                 // Подозрительный IP
  CANCEL_RATE        // Высокий процент отмен
  DISPUTE_RATE       // Частые споры
}

// Статусы алертов
enum AlertStatus {
  OPEN         // Открыт
  REVIEWING    // На проверке
  RESOLVED     // Решён (ложный)
  CONFIRMED    // Подтверждён (фрод)
}

model User {
  id              String   @id @default(uuid())
  telegramId      String   @unique
  username        String?
  reputationScore Float    @default(5.0)
  totalTrades     Int      @default(0)
  balance         Float    @default(0.0)  // Баланс USDT
  blockedBalance  Float    @default(0.0)  // Заблокировано в эскроу
  riskScore       Float    @default(0.0)  // Уровень риска (0-100)
  isBlocked       Boolean  @default(false)  // Заблокирован
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders        Order[]
  transactions  Transaction[]
  disputes      Dispute[]
  alerts        FraudAlert[]
  loginSessions LoginSession[]
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  type            String      // BUY or SELL
  pair            String      @default("USDT/RUB")
  rate            Float
  minLimit        Float
  maxLimit        Float
  amount          Float       // Сумма в USDT
  reservedAmount  Float       @default(0.0)  // Зарезервировано
  paymentMethods  String[]
  status          OrderStatus @default(PENDING)
  expiresAt       DateTime?   // Время истечения резерва
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Стороны сделки
  sellerId        String?
  buyerId         String?
  seller          User        @relation("SellerOrders", fields: [sellerId], references: [id])
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])

  // Связанные сущности
  transactions    Transaction[]
  dispute         Dispute?

  @@index([status])
  @@index([createdAt])
  @@index([sellerId])
  @@index([buyerId])
}

model Transaction {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id])
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  type        TransactionType
  amount      Float
  balanceBefore Float
  balanceAfter  Float
  description String?
  metadata    Json?           // Дополнительные данные
  createdAt   DateTime        @default(now())

  @@index([orderId])
  @@index([userId])
}

model Dispute {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  initiatorId String
  initiator   User     @relation(fields: [initiatorId], references: [id])
  reason      String   // Причина спора
  description String?
  status      String   @default("OPEN")  // OPEN, IN_REVIEW, RESOLVED
  resolution  String?  // Решение арбитра
  resolvedBy  String?  // ID админа
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model FraudAlert {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  type        AlertType
  status      AlertStatus @default(OPEN)
  score       Int         // Уровень опасности (0-100)
  title       String
  description String?
  metadata    Json?       // Детали алерта
  reviewedBy  String?     // ID админа
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([status])
  @@index([userId])
  @@index([type])
}

model LoginSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  ipAddress  String?
  userAgent  String?
  fingerprint String? // Отпечаток устройства
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@index([fingerprint])
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("ADMIN")  // ADMIN, SUPER_ADMIN
  createdAt    DateTime @default(now())
}
