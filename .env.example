# Database
POSTGRES_USER=p2pspb
POSTGRES_PASSWORD=p2pspb_password_change_me
POSTGRES_DB=p2pspb
POSTGRES_PORT=5432

# API
PORT=4000
FRONTEND_URL=http://localhost:3000
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_change_me
ADMIN_SESSION_TOKEN=your_admin_session_token_change_me

# Security
JWT_SECRET=your_jwt_secret_key_change_me_in_production_min_32_chars
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_change_me

# Demo Mode (для презентаций инвесторам)
DEMO_MODE=false
DEMO_INTERVAL_MS=30000

# AML Integration
AML_API_URL=http://localhost:5678/webhook
AML_ENABLED=false

# Blockchain (Smart Contracts)
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here
PSPB_TOKEN_ADDRESS=0x...
PSPB_ESCROW_ADDRESS=0x...
PSPB_FEE_SPLITTER_ADDRESS=0x...

# Settlement Mode
# centralized - только БД (быстро, дёшево)
# blockchain - только блокчейн (прозрачно, дорого)
# hybrid - БД + блокчейн для settlement (оптимально)
SETTLEMENT_MODE=centralized

# Sentry (Error Tracking)
SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# Database URL for Prisma
DATABASE_URL="postgresql://p2pspb:p2pspb_password_change_me@localhost:5432/p2pspb?schema=public"

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_ADMIN_SESSION_TOKEN=your_admin_session_token_change_me

# Ports
API_PORT=4000
WEB_PORT=3000
REDIS_PORT=6379
